{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"cli": {
		"cache": {
			"enabled": false
		},
		"analytics": false
	},
	"version": 1,
	"newProjectRoot": "projects",
	"projects": {
		"portfolio": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "projects/portfolio",
			"sourceRoot": "projects/portfolio/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "ngx-build-plus:browser",
					"options": {
						"outputPath": "dist/portfolio",
						"index": "projects/portfolio/src/index.html",
						"polyfills": [
							"zone.js"
						],
						"tsConfig": "projects/portfolio/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/portfolio/src/favicon.ico",
							"projects/portfolio/src/assets"
						],
						"styles": [
							"projects/portfolio/src/styles.scss"
						],
						"scripts": [],
						"main": "projects/portfolio/src/main.ts",
						"extraWebpackConfig": "projects/portfolio/webpack.config.js",
						"commonChunk": false
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "1mb",
									"maximumError": "2mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "100kb",
									"maximumError": "200kb"
								}
							],
							"outputHashing": "all",
							"extractLicenses": false,
							"extraWebpackConfig": "projects/portfolio/webpack.prod.config.js",
							"fileReplacements": [
								{
									"replace": "projects/portfolio/src/environments/environment.ts",
									"with": "projects/portfolio/src/environments/environment.prod.ts"
								}
							]
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true,
							"namedChunks": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "ngx-build-plus:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "portfolio:build:production",
							"extraWebpackConfig": "projects/portfolio/webpack.prod.config.js"
						},
						"development": {
							"buildTarget": "portfolio:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"port": 4200,
						"publicHost": "http://localhost:4200",
						"extraWebpackConfig": "projects/portfolio/webpack.config.js"
					}
				},
				"extract-i18n": {
					"builder": "ngx-build-plus:extract-i18n",
					"options": {
						"buildTarget": "portfolio:build",
						"extraWebpackConfig": "projects/portfolio/webpack.config.js"
					}
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": [
							"zone.js",
							"zone.js/testing"
						],
						"tsConfig": "projects/portfolio/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							"projects/portfolio/src/favicon.ico",
							"projects/portfolio/src/assets"
						],
						"styles": [
							"projects/portfolio/src/styles.scss"
						],
						"scripts": []
					}
				}
			}
		}
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}